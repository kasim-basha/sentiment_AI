# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your_api_key_here"

# APP_URL:"http://localhost:3000"
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AUTH_SECRET: Cryptographic secret key used to sign and verify JWT authentication tokens.
AUTH_SECRET="my_secret_project_1234"

# DATABASE_FILE: Optional path to the persistent JSON/SQLite database storage file.
DATABASE_FILE="./data/sentimentai.json"

# STORAGE_PATH: Directory path for uploaded multimodal media assets and file storage.
STORAGE_PATH="./data/uploads"

# NODE_ENV: Runtime environment (development | production)
NODE_ENV="development"
